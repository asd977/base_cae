/*
 * POWERCHINA-GEOCAE engineering blue theme
 *
 * Direction:
 * - keep the existing engineering workflow and native desktop character;
 * - keep classic blue-grey gradients on structural chrome;
 * - use one continuous blue-white workspace instead of alternating blue and white blocks;
 * - reserve pure white for editable fields and dense data views.
 */

QWidget {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "微软雅黑", "Segoe UI", sans-serif;
    font-size: 9pt;
    color: #1a3a52;
    background-color: #edf4f9;
}

QMainWindow,
QDialog {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #dceaf3, stop:1 #ccdeea);
}

QLabel {
    color: #1a3a52;
    background: transparent;
}

QFrame,
QToolBar,
QToolButton,
QCheckBox,
QRadioButton {
    background: transparent;
}

/* The dock title already identifies the current settings area. */
QLabel#pageHeaderLabel {
    min-height: 0px;
    max-height: 0px;
    margin: 0px;
    padding: 0px;
    border: none;
    color: transparent;
    background: transparent;
}

QLabel#pageNameLabel {
    color: #1a3a52;
    font-size: 9.5pt;
    font-weight: 600;
    padding: 0px;
}

QLabel[secondary="true"],
QLabel#boxSelectHintLabel {
    color: #60798b;
}

/* Engineering-blue uses blue chrome and clean white working surfaces. */
DashboardPage#dashboardPage,
QScrollArea#dashboardScrollArea,
QScrollArea#dashboardScrollArea > QWidget,
QWidget#dashboardScrollContainer,
QWidget#materialEntryContent,
MaterialModelWidget#materialModelPage,
MaterialTransitionPage#materialTransitionPage,
QStackedWidget#projectSettingStackWidget,
QStackedWidget#projectSettingStackWidget > QWidget {
    background: #edf4f9;
}

QScrollArea#dashboardScrollArea QWidget#qt_scrollarea_viewport {
    background: #edf4f9;
}


/* Mesh quality page uses the current theme's editable/content surface.
   The C++ page does not hard-code any color; QPalette::Base changes with the theme. */
MeshQualityCheckWidget#meshQualityCheckPage,
QScrollArea#meshQualityCheckScrollArea,
QWidget#meshQualityCheckViewport,
QWidget#meshQualityCheckContent {
    background-color: #edf4f9;
}

/* -------------------------------------------------------------------------
   Buttons
   ------------------------------------------------------------------------- */
QPushButton {
    min-height: 26px;
    padding: 0px 10px;
    color: #1a3a52;
    background: #ffffff;
    border: 1px solid #a8bfce;
    border-radius: 2px;
}

QPushButton:hover {
    color: #2878b0;
    background: #deedf6;
    border-color: #719bb8;
}

QPushButton:pressed {
    background: #cce2f0;
    border-color: #6994b1;
}

QPushButton:disabled {
    color: #8799a8;
    background: #f1f5f8;
    border-color: #c4d2dc;
}

QPushButton:default,
QPushButton[primary="true"] {
    color: #ffffff;
    background: #2878b0;
    border-color: #2878b0;
    font-weight: 500;
}

QPushButton:default:hover,
QPushButton[primary="true"]:hover {
    background: #216a9e;
    border-color: #216a9e;
}

QPushButton:default:pressed,
QPushButton[primary="true"]:pressed {
    background: #195985;
    border-color: #195985;
}

/* Collapsible section controls remain structural, not decorative bands. */
QPushButton#sectionTitleButton {
    min-height: 29px;
    max-height: 29px;
    padding: 0px 2px;
    text-align: left;
    color: #1a3a52;
    background: transparent;
    border: none;
    border-bottom: 1px solid #c1d0da;
    border-radius: 0px;
    font-weight: 600;
}

QPushButton#sectionTitleButton:hover {
    color: #286b9a;
    background: transparent;
    border-bottom-color: #a8bdca;
}

/* -------------------------------------------------------------------------
   Editors
   ------------------------------------------------------------------------- */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit,
QTimeEdit,
QDateEdit {
    min-height: 26px;
    padding-left: 6px;
    padding-right: 6px;
    color: #1a3a52;
    background: #ffffff;
    border: 1px solid #a8bfce;
    border-radius: 2px;
    selection-background-color: #c9e2f2;
    selection-color: #1a3a52;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateTimeEdit:hover,
QTimeEdit:hover,
QDateEdit:hover {
    border-color: #8eabba;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus,
QTimeEdit:focus,
QDateEdit:focus {
    border-color: #7799af;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: #8b9aa6;
    background: #f1f5f8;
    border-color: #c4d2dc;
}

QComboBox {
    min-height: 26px;
    padding-left: 6px;
    padding-right: 3px;
    color: #1a3a52;
    background: #ffffff;
    border: 1px solid #a8bfce;
    border-radius: 2px;
}

QComboBox:hover {
    border-color: #8eabba;
}

QComboBox:focus {
    border-color: #7799af;
}

QComboBox:disabled {
    color: #8b9aa6;
    background: #f1f5f8;
    border-color: #c4d2dc;
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    background: transparent;
    border: none;
}

QComboBox::down-arrow {
    image: url(:/resources/arrow_down_drawn.svg);
    width: 8px;
    height: 8px;
}

QComboBox QAbstractItemView {
    color: #1a3a52;
    background: #ffffff;
    border: 1px solid #a8bfce;
    outline: none;
    padding: 2px;
    selection-background-color: #bcdcf0;
    selection-color: #1b415b;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 17px;
    background: #deedf6;
    border-left: 1px solid #c2d1db;
    border-bottom: 1px solid #c2d1db;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 17px;
    background: #deedf6;
    border-left: 1px solid #c2d1db;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(:/resources/arrow_up_drawn.svg);
    width: 8px;
    height: 8px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(:/resources/arrow_down_drawn.svg);
    width: 8px;
    height: 8px;
}

QCheckBox,
QRadioButton {
    spacing: 5px;
    color: #1a3a52;
}

/* Checkbox indicators are drawn globally by NeutralCheckStyle.
   Keep only text spacing here so QCheckBox and item-view checks stay consistent. */

/* -------------------------------------------------------------------------
   Sections and content surfaces
   ------------------------------------------------------------------------- */
QGroupBox {
    /* A very light gradient keeps sections readable without turning them into white cards. */
    margin-top: 12px;
    padding: 7px 6px 6px 6px;
    color: #1a3a52;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fbfdfe, stop:1 #f4f8fb);
    border: 1px solid #afc6d5;
    border-radius: 2px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 6px;
    top: 0px;
    padding: 0px 3px;
    color: #1a3a52;
    background: #edf4f9;
}

QGroupBox::indicator {
    width: 14px;
    height: 14px;
    margin-right: 3px;
}

QStackedWidget#projectSettingStackWidget,
QStackedWidget#projectSettingStackWidget > QWidget,
DashboardPage {
    background: #edf4f9;
}

MaterialEntryWidget,
MaterialTransitionPage,
MaterialModelWidget,
CaveBlockPlanePage,
CaveBlockStabilityWidget,
QScrollArea,
QScrollArea > QWidget {
    background: #edf4f9;
}

QWidget[dimDisabled="true"] {
    color: #8d9ca8;
    background: #f1f5f8;
}

/* -------------------------------------------------------------------------
   Tree, lists and tables
   ------------------------------------------------------------------------- */
QTreeWidget#projectTreeWidget {
    color: #1a3a52;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f8fbfd, stop:1 #f1f6fa);
    border: none;
    outline: none;
    show-decoration-selected: 1;
}

QTreeWidget#projectTreeWidget::item {
    height: 26px;
    padding-left: 4px;
    padding-right: 5px;
    color: #1a3a52;
    background: transparent;
    border: none;
    font-weight: 400;
}

QTreeWidget#projectTreeWidget::item:hover {
    color: #2f6f9f;
    background: #e7f0f6;
}

QTreeWidget#projectTreeWidget::item:disabled {
    color: #7890a2;
    background: #f4f7f9;
}

QTreeWidget#projectTreeWidget::item:selected {
    color: #17415d;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #cfe4f1, stop:1 #e4f0f7);
    border-left: 2px solid #4f83a7;
}

QTreeWidget#projectTreeWidget::item:selected:hover {
    background: #d3e5f0;
}

QListWidget,
QTreeView,
QListView,
QTableView,
QTableWidget {
    color: #1a3a52;
    background: #fbfdfe;
    border: 1px solid #afc6d5;
    alternate-background-color: #f1f6f9;
    gridline-color: #cedae2;
    outline: none;
    selection-background-color: #c9e2f2;
    selection-color: #1a3a52;
}

QListWidget::item,
QListView::item {
    min-height: 24px;
    padding: 3px 6px;
}

QListWidget#appliedMatypesList::item {
    min-height: 24px;
    padding: 2px 5px;
}

QListWidget::item:hover,
QListView::item:hover {
    background: #deedf6;
}

QListWidget::item:selected,
QListView::item:selected {
    color: #1b3d53;
    background: #d9e9f3;
}

QHeaderView::section {
    min-height: 27px;
    padding: 0px 7px;
    color: #1a3a52;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f7fbfd, stop:1 #e4eef5);
    border: none;
    border-right: 1px solid #bfd0db;
    border-bottom: 1px solid #aebfcb;
    font-weight: 500;
}

/* -------------------------------------------------------------------------
   Standard tabs: flat desktop tabs, not rounded chips
   ------------------------------------------------------------------------- */
QTabWidget::pane {
    background: #f7fafc;
    border: 1px solid #afc6d5;
}

QTabBar::tab {
    min-height: 28px;
    padding: 0px 13px;
    margin: 0px;
    color: #1a3a52;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f7fbfd, stop:1 #e3edf4);
    border: none;
    border-right: 1px solid #bfd0da;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
}

QTabBar::tab:hover:!selected {
    color: #285c7d;
    background: #deedf6;
}

QTabBar::tab:selected {
    color: #2878b0;
    background: #f7fafc;
    border-bottom: 2px solid #2675ad;
    font-weight: 600;
}

/* -------------------------------------------------------------------------
   Menus and tooltips
   ------------------------------------------------------------------------- */
QMenu {
    color: #1a3a52;
    background: #ffffff;
    border: 1px solid #a8bfce;
    padding: 5px;
}

QMenu::item {
    min-height: 20px;
    padding: 5px 30px 5px 25px;
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 3px;
}

QMenu::item:selected {
    color: #1b3d53;
    background: #d9e9f3;
    border-left-color: #2878b0;
}

QMenu::item:disabled {
    color: #8799a8;
}

QMenu::separator {
    height: 1px;
    margin: 5px 8px;
    background: #c7d5de;
}

QToolTip {
    color: #ffffff;
    background: #294b62;
    border: none;
    padding: 5px 8px;
}

/* -------------------------------------------------------------------------
   Scrollbars
   ------------------------------------------------------------------------- */
QScrollBar:vertical {
    width: 9px;
    margin: 2px 1px;
    background: transparent;
    border: none;
}

QScrollBar:horizontal {
    height: 9px;
    margin: 1px 2px;
    background: transparent;
    border: none;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    min-height: 24px;
    min-width: 24px;
    background: #aebfca;
    border: none;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #8faabd;
}

QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background: #7693a7;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* -------------------------------------------------------------------------
   Visualization toolbar
   ------------------------------------------------------------------------- */
QFrame#visualizationViewToolbar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f8fbfd, stop:1 #e6f0f6);
    border-bottom: 1px solid #b8cad6;
}

QFrame#visualizationViewToolbar QToolButton {
    min-width: 27px;
    min-height: 25px;
    padding: 2px;
    color: #1a3a52;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
}

QFrame#visualizationViewToolbar QToolButton:hover {
    background: #deedf6;
    border-color: #b5cbd9;
}

QFrame#visualizationViewToolbar QToolButton:pressed,
QFrame#visualizationViewToolbar QToolButton:checked {
    background: #d7e7f1;
    border-color: #9eb5c4;
}

QFrame#visualizationToolbarSeparator {
    color: #c4d2dc;
}

QMenu#visualizationOpacityMenu {
    background: #ffffff;
    border: 1px solid #a8bfce;
    padding: 6px;
}

QLabel#visualizationOpacityPercentLabel {
    color: #1a3a52;
    font-weight: 600;
}

QSlider#visualizationOpacitySlider::groove:vertical {
    width: 4px;
    background: #d7e1e8;
    border-radius: 2px;
}

QSlider#visualizationOpacitySlider::sub-page:vertical {
    background: #2675ad;
    border-radius: 2px;
}

QSlider#visualizationOpacitySlider::add-page:vertical {
    background: #d7e1e8;
    border-radius: 2px;
}

QSlider#visualizationOpacitySlider::handle:vertical {
    height: 12px;
    margin: 0px -4px;
    background: #2675ad;
    border-radius: 6px;
}

QStatusBar {
    color: #1a3a52;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #eef5f9, stop:1 #dfeaf2);
    border-top: 1px solid #b6c9d6;
}


/* -------------------------------------------------------------------------
   Engineering-blue surface hierarchy
   1) chrome: visible blue-grey gradients;
   2) workspace: one continuous pale blue-white surface;
   3) editors/data cells: near-white for clarity.
   ------------------------------------------------------------------------- */
QWidget#meshQualityCheckContent,
QWidget#meshQualityCheckViewport,
QScrollArea#meshQualityCheckScrollArea,
MeshQualityCheckWidget#meshQualityCheckPage,
QWidget#materialEntryContent,
MaterialModelWidget#materialModelPage,
MaterialTransitionPage#materialTransitionPage,
QStackedWidget#projectSettingStackWidget,
QStackedWidget#projectSettingStackWidget > QWidget {
    background: #edf4f9;
}

QTextEdit,
QPlainTextEdit,
QTableView,
QTableWidget,
QListView,
QListWidget,
QTabWidget::pane {
    background: #fbfdfe;
}

QGroupBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fbfdfe, stop:1 #f4f8fb);
    border-color: #afc6d5;
}

QGroupBox::title {
    background: #edf4f9;
}

/* -------------------------------------------------------------------------
   Navigation and output surfaces
   - navigation stays inside the blue-grey frame instead of reading as a
     detached white sheet;
   - output remains quiet and readable, but avoids a large pure-white block.
   ------------------------------------------------------------------------- */
QWidget#OutputWidget {
    background: #edf4f9;
}

QWidget#OutputWidget QTextEdit#textEdit {
    color: #1a3a52;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fbfdfe, stop:1 #f6fafc);
    border: none;
    border-radius: 0px;
}

/* -------------------------------------------------------------------------
   Stronger reference-blue pass.
   ------------------------------------------------------------------------- */
QWidget {
    color: #073760;
    background-color: #e7f4fd;
}

QMainWindow,
QDialog {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #d8edf9, stop:1 #bfdcf2);
}

QLabel,
QLabel#pageNameLabel,
QCheckBox,
QRadioButton {
    color: #073760;
}

QLabel[secondary="true"],
QLabel#boxSelectHintLabel {
    color: #3f7193;
}

DashboardPage#dashboardPage,
QScrollArea#dashboardScrollArea,
QScrollArea#dashboardScrollArea > QWidget,
QWidget#dashboardScrollContainer,
QWidget#materialEntryContent,
MaterialModelWidget#materialModelPage,
MaterialTransitionPage#materialTransitionPage,
QStackedWidget#projectSettingStackWidget,
QStackedWidget#projectSettingStackWidget > QWidget,
MeshQualityCheckWidget#meshQualityCheckPage,
QScrollArea#meshQualityCheckScrollArea,
QWidget#meshQualityCheckViewport,
QWidget#meshQualityCheckContent,
MaterialEntryWidget,
CaveBlockPlanePage,
CaveBlockStabilityWidget,
QScrollArea,
QScrollArea > QWidget,
QWidget#OutputWidget {
    background: #e7f4fd;
}

QPushButton {
    color: #073760;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #d9edf9);
    border: 1px solid #7fb0d3;
}

QPushButton:hover {
    color: #005fa8;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f8fdff, stop:1 #cce8fa);
    border-color: #2f80bb;
}

QPushButton:pressed {
    background: #add9f3;
    border-color: #1d75b7;
}

QPushButton:default,
QPushButton[primary="true"] {
    color: #ffffff;
    background: #006ec2;
    border-color: #006ec2;
}

QPushButton:default:hover,
QPushButton[primary="true"]:hover {
    background: #137ecf;
    border-color: #137ecf;
}

QPushButton:default:pressed,
QPushButton[primary="true"]:pressed {
    background: #00599f;
    border-color: #00599f;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit,
QTimeEdit,
QDateEdit,
QComboBox {
    color: #073760;
    background: #fbfeff;
    border: 1px solid #7fb0d3;
    selection-background-color: #b8def6;
    selection-color: #073760;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateTimeEdit:hover,
QTimeEdit:hover,
QDateEdit:hover,
QComboBox:hover {
    border-color: #2f80bb;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus,
QTimeEdit:focus,
QDateEdit:focus,
QComboBox:focus {
    border-color: #006ec2;
}

QComboBox QAbstractItemView,
QMenu {
    color: #073760;
    background: #fbfeff;
    border: 1px solid #7fb0d3;
    selection-background-color: #b8def6;
    selection-color: #073760;
}

QComboBox QAbstractItemView::item:selected,
QMenu::item:selected {
    color: #073760;
    background: #b8def6;
}

QGroupBox {
    color: #073760;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fbfeff, stop:1 #e1f2fc);
    border-color: #7fb0d3;
}

QGroupBox::title {
    color: #073760;
    background: #e7f4fd;
}

QTreeWidget#projectTreeWidget {
    color: #073760;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fbfeff, stop:1 #e1f2fc);
}

QTreeWidget#projectTreeWidget::item {
    color: #073760;
}

QTreeWidget#projectTreeWidget::item:hover {
    color: #005fa8;
    background: #cce8fa;
}

QTreeWidget#projectTreeWidget::item:selected {
    color: #003f75;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #b8def6, stop:1 #dcf1fc);
    border-left: 2px solid #006ec2;
}

QListWidget,
QTreeView,
QListView,
QTableView,
QTableWidget,
QTabWidget::pane {
    color: #073760;
    background: #fbfeff;
    border-color: #7fb0d3;
    alternate-background-color: #e4f3fc;
    gridline-color: #b6d5eb;
    selection-background-color: #b8def6;
    selection-color: #073760;
}

QHeaderView::section {
    color: #073760;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f8fdff, stop:1 #d2eafb);
    border-right: 1px solid #9bc6e3;
    border-bottom: 1px solid #72a9cf;
}

QTabBar::tab {
    color: #073760;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f9fdff, stop:1 #d4ecfb);
    border-right-color: #9bc6e3;
}

QTabBar::tab:hover:!selected {
    color: #005fa8;
    background: #cce8fa;
}

QTabBar::tab:selected {
    color: #006ec2;
    background: #fbfeff;
    border-bottom-color: #006ec2;
}

QFrame#visualizationViewToolbar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f9fdff, stop:1 #d2eafb);
    border-bottom: 1px solid #72a9cf;
}

QFrame#visualizationViewToolbar QToolButton:hover {
    background: #cce8fa;
    border-color: #7fb0d3;
}

QFrame#visualizationViewToolbar QToolButton:pressed,
QFrame#visualizationViewToolbar QToolButton:checked {
    background: #add9f3;
    border-color: #2f80bb;
}

QSlider#visualizationOpacitySlider::sub-page:vertical,
QSlider#visualizationOpacitySlider::handle:vertical {
    background: #006ec2;
}

QStatusBar {
    color: #073760;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #eaf6fe, stop:1 #c9e4f6);
    border-top: 1px solid #72a9cf;
}

QWidget#OutputWidget QTextEdit#textEdit {
    color: #073760;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fbfeff, stop:1 #e8f6fe);
}

/* Model tree and log panes need the same blue surface treatment as dock chrome. */
ProjectTreeWidget,
ProjectTreeWidget QTreeWidget#projectTreeWidget,
ProjectTreeWidget QTreeWidget#projectTreeWidget QWidget#qt_scrollarea_viewport {
    background: #edf8ff;
}

ProjectTreeWidget QTreeWidget#projectTreeWidget {
    color: #073760;
    border: none;
    outline: none;
    show-decoration-selected: 1;
}

ProjectTreeWidget QTreeWidget#projectTreeWidget::item {
    min-height: 28px;
    padding-left: 5px;
    padding-right: 6px;
    color: #073760;
    background: transparent;
    border-left: 3px solid transparent;
}

ProjectTreeWidget QTreeWidget#projectTreeWidget::item:hover {
    color: #005fa8;
    background: #d3edfb;
    border-left-color: #7fb9dd;
}

ProjectTreeWidget QTreeWidget#projectTreeWidget::item:selected {
    color: #003f75;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #a9d9f5, stop:1 #dff3fd);
    border-left-color: #006ec2;
    font-weight: 500;
}

ProjectTreeWidget QTreeWidget#projectTreeWidget::item:selected:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #9fd3f2, stop:1 #d3edfb);
}

QWidget#OutputWidget,
QWidget#OutputWidget QTextEdit#textEdit,
QWidget#OutputWidget QTextEdit#textEdit QWidget#qt_scrollarea_viewport {
    background: #edf8ff;
}

QWidget#OutputWidget QTextEdit#textEdit {
    color: #073760;
    border: none;
    padding: 8px;
    selection-background-color: #b8def6;
    selection-color: #073760;
}

QWidget#OutputWidget QPushButton#floatingClearBtn {
    min-height: 22px;
    max-height: 22px;
    min-width: 44px;
    max-width: 44px;
    padding: 0px;
    color: #005fa8;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #d4ecfb);
    border: 1px solid #7fb0d3;
    border-radius: 2px;
}

QWidget#OutputWidget QPushButton#floatingClearBtn:hover {
    color: #003f75;
    background: #cce8fa;
    border-color: #2f80bb;
}

QWidget#OutputWidget QPushButton#floatingClearBtn:pressed {
    background: #add9f3;
    border-color: #1d75b7;
}

/* New/open project dialog: keep labels and fields inside the same blue surface. */
ProjectSetupDialog,
ProjectSetupDialog QWidget {
    background: #d8edf9;
}

ProjectSetupDialog QLabel {
    color: #073760;
    background: transparent;
}

ProjectSetupDialog QLineEdit {
    color: #073760;
    background: #edf8ff;
    border: 1px solid #2f80bb;
    selection-background-color: #b8def6;
    selection-color: #073760;
    placeholder-text-color: #6689a4;
}

ProjectSetupDialog QLineEdit:focus {
    background: #f2faff;
    border-color: #006ec2;
}

ProjectSetupDialog QPushButton {
    color: #005fa8;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f8fdff, stop:1 #d4ecfb);
    border: 1px solid #7fb0d3;
}

ProjectSetupDialog QPushButton:hover {
    color: #003f75;
    background: #cce8fa;
    border-color: #2f80bb;
}

ProjectSetupDialog QPushButton:pressed {
    background: #add9f3;
    border-color: #1d75b7;
}
