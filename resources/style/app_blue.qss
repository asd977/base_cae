/*
 * POWERCHINA-GEOCAE engineering blue theme
 *
 * Direction:
 * - keep the existing engineering workflow and native desktop character;
 * - use neutral surfaces with one restrained blue-grey accent;
 * - avoid card-like styling on every container;
 * - reserve emphasis for selection, focus and primary actions.
 */

QWidget {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "微软雅黑", "Segoe UI", sans-serif;
    font-size: 9pt;
    color: #173247;
    background-color: #edf5fa;
}

QMainWindow,
QDialog {
    background: #dceaf4;
}

QLabel {
    color: #173247;
    background: transparent;
}

QFrame,
QToolBar,
QToolButton,
QCheckBox,
QRadioButton {
    background: transparent;
}

/* The dock title already identifies the current settings area. */
QLabel#pageHeaderLabel {
    min-height: 0px;
    max-height: 0px;
    margin: 0px;
    padding: 0px;
    border: none;
    color: transparent;
    background: transparent;
}

QLabel#pageNameLabel {
    color: #173247;
    font-size: 9.5pt;
    font-weight: 600;
    padding: 0px;
}

QLabel[secondary="true"],
QLabel#boxSelectHintLabel {
    color: #587286;
}

/* Engineering-blue uses blue chrome and clean white working surfaces. */
DashboardPage#dashboardPage,
QScrollArea#dashboardScrollArea,
QScrollArea#dashboardScrollArea > QWidget,
QWidget#dashboardScrollContainer,
QWidget#materialEntryContent,
MaterialModelWidget#materialModelPage,
MaterialTransitionPage#materialTransitionPage,
QStackedWidget#projectSettingStackWidget,
QStackedWidget#projectSettingStackWidget > QWidget {
    background: #f7fbfe;
}

QScrollArea#dashboardScrollArea QWidget#qt_scrollarea_viewport {
    background: #f7fbfe;
}


/* Mesh quality page uses the current theme's editable/content surface.
   The C++ page does not hard-code any color; QPalette::Base changes with the theme. */
MeshQualityCheckWidget#meshQualityCheckPage,
QScrollArea#meshQualityCheckScrollArea,
QWidget#meshQualityCheckViewport,
QWidget#meshQualityCheckContent {
    background-color: palette(base);
}

/* -------------------------------------------------------------------------
   Buttons
   ------------------------------------------------------------------------- */
QPushButton {
    min-height: 26px;
    padding: 0px 10px;
    color: #173247;
    background: #ffffff;
    border: 1px solid #a8c1d3;
    border-radius: 2px;
}

QPushButton:hover {
    color: #2f6f9f;
    background: #f0f6fa;
    border-color: #6f96b2;
}

QPushButton:pressed {
    background: #cbdfea;
    border-color: #5f89a8;
}

QPushButton:disabled {
    color: #8799a8;
    background: #eef5fa;
    border-color: #bed0dc;
}

QPushButton:default,
QPushButton[primary="true"] {
    color: #ffffff;
    background: #2f73a3;
    border-color: #2f73a3;
    font-weight: 500;
}

QPushButton:default:hover,
QPushButton[primary="true"]:hover {
    background: #286894;
    border-color: #286894;
}

QPushButton:default:pressed,
QPushButton[primary="true"]:pressed {
    background: #20587f;
    border-color: #20587f;
}

/* Collapsible section controls remain structural, not decorative bands. */
QPushButton#sectionTitleButton {
    min-height: 29px;
    max-height: 29px;
    padding: 0px 2px;
    text-align: left;
    color: #173247;
    background: transparent;
    border: none;
    border-bottom: 1px solid #bcd1df;
    border-radius: 0px;
    font-weight: 600;
}

QPushButton#sectionTitleButton:hover {
    color: #286b9a;
    background: transparent;
    border-bottom-color: #9fb9cb;
}

/* -------------------------------------------------------------------------
   Editors
   ------------------------------------------------------------------------- */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit,
QTimeEdit,
QDateEdit {
    min-height: 26px;
    padding-left: 6px;
    padding-right: 6px;
    color: #173247;
    background: #ffffff;
    border: 1px solid #a8c1d3;
    border-radius: 2px;
    selection-background-color: #c4deef;
    selection-color: #173a51;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateTimeEdit:hover,
QTimeEdit:hover,
QDateEdit:hover {
    border-color: #86a8bf;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus,
QTimeEdit:focus,
QDateEdit:focus {
    border-color: #5f89a8;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: #8b9aa6;
    background: #eef5fa;
    border-color: #bed0dc;
}

QComboBox {
    min-height: 26px;
    padding-left: 6px;
    padding-right: 3px;
    color: #173247;
    background: #ffffff;
    border: 1px solid #a8c1d3;
    border-radius: 2px;
}

QComboBox:hover {
    border-color: #86a8bf;
}

QComboBox:focus {
    border-color: #5f89a8;
}

QComboBox:disabled {
    color: #8b9aa6;
    background: #eef5fa;
    border-color: #bed0dc;
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    background: transparent;
    border: none;
}

QComboBox::down-arrow {
    image: url(:/resources/arrow_down_drawn.svg);
    width: 8px;
    height: 8px;
}

QComboBox QAbstractItemView {
    color: #173247;
    background: #ffffff;
    border: 1px solid #a8c1d3;
    outline: none;
    padding: 2px;
    selection-background-color: #c8e0f0;
    selection-color: #1b415b;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 17px;
    background: #e1edf6;
    border-left: 1px solid #b2c9d9;
    border-bottom: 1px solid #b2c9d9;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 17px;
    background: #e1edf6;
    border-left: 1px solid #b2c9d9;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(:/resources/arrow_up_drawn.svg);
    width: 8px;
    height: 8px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(:/resources/arrow_down_drawn.svg);
    width: 8px;
    height: 8px;
}

QCheckBox,
QRadioButton {
    spacing: 5px;
    color: #173247;
}

/* Checkbox indicators are drawn globally by NeutralCheckStyle.
   Keep only text spacing here so QCheckBox and item-view checks stay consistent. */

/* -------------------------------------------------------------------------
   Sections and content surfaces
   ------------------------------------------------------------------------- */
QGroupBox {
    /* margin-top reserves space for the title; content padding remains compact. */
    margin-top: 12px;
    padding: 7px 6px 6px 6px;
    color: #173247;
    background: #ffffff;
    border: 1px solid #bed0dc;
    border-radius: 2px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 6px;
    top: 0px;
    padding: 0px 3px;
    color: #173247;
    background: #ffffff;
}

QGroupBox::indicator {
    width: 14px;
    height: 14px;
    margin-right: 3px;
}

QStackedWidget#projectSettingStackWidget,
QStackedWidget#projectSettingStackWidget > QWidget,
DashboardPage {
    background: #f7fbfe;
}

MaterialEntryWidget,
MaterialTransitionPage,
MaterialModelWidget,
CaveBlockPlanePage,
CaveBlockStabilityWidget,
QScrollArea,
QScrollArea > QWidget {
    background: #ffffff;
}

QWidget[dimDisabled="true"] {
    color: #8d9ca8;
    background: #eef5fa;
}

/* -------------------------------------------------------------------------
   Tree, lists and tables
   ------------------------------------------------------------------------- */
QTreeWidget#projectTreeWidget {
    color: #173247;
    background: #ffffff;
    border: none;
    outline: none;
    show-decoration-selected: 1;
}

QTreeWidget#projectTreeWidget::item {
    height: 26px;
    padding-left: 4px;
    padding-right: 5px;
    color: #173247;
    background: transparent;
    border: none;
    font-weight: 400;
}

QTreeWidget#projectTreeWidget::item:hover {
    color: #2f6f9f;
    background: #d8e9f4;
}

QTreeWidget#projectTreeWidget::item:disabled {
    color: #7890a2;
    background: #f3f7fa;
}

QTreeWidget#projectTreeWidget::item:selected {
    color: #1b3d53;
    background: #c4deef;
}

QTreeWidget#projectTreeWidget::item:selected:hover {
    background: #bfd9ea;
}

QListWidget,
QTreeView,
QListView,
QTableView,
QTableWidget {
    color: #173247;
    background: #ffffff;
    border: 1px solid #bed0dc;
    alternate-background-color: #e7f1f8;
    gridline-color: #c4d6e2;
    outline: none;
    selection-background-color: #c4deef;
    selection-color: #1b3d53;
}

QListWidget::item,
QListView::item {
    min-height: 24px;
    padding: 3px 6px;
}

QListWidget#appliedMatypesList::item {
    min-height: 24px;
    padding: 2px 5px;
}

QListWidget::item:hover,
QListView::item:hover {
    background: #d8e9f4;
}

QListWidget::item:selected,
QListView::item:selected {
    color: #1b3d53;
    background: #c4deef;
}

QHeaderView::section {
    min-height: 27px;
    padding: 0px 7px;
    color: #173247;
    background: #eef4f8;
    border: none;
    border-right: 1px solid #bfd1de;
    border-bottom: 1px solid #b8ccd9;
    font-weight: 500;
}

/* -------------------------------------------------------------------------
   Standard tabs: flat desktop tabs, not rounded chips
   ------------------------------------------------------------------------- */
QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #bed0dc;
}

QTabBar::tab {
    min-height: 28px;
    padding: 0px 13px;
    margin: 0px;
    color: #173247;
    background: #eef4f8;
    border: none;
    border-right: 1px solid #bcd1df;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
}

QTabBar::tab:hover:!selected {
    color: #285c7d;
    background: #e1edf6;
}

QTabBar::tab:selected {
    color: #2f73a3;
    background: #ffffff;
    border-bottom: 2px solid #347aa8;
    font-weight: 600;
}

/* -------------------------------------------------------------------------
   Menus and tooltips
   ------------------------------------------------------------------------- */
QMenu {
    color: #173247;
    background: #ffffff;
    border: 1px solid #a8c1d3;
    padding: 3px 0px;
}

QMenu::item {
    padding: 6px 28px 6px 12px;
    background: transparent;
}

QMenu::item:selected {
    color: #1b3d53;
    background: #c4deef;
}

QMenu::separator {
    height: 1px;
    margin: 4px 9px;
    background: #bfd2df;
}

QToolTip {
    color: #ffffff;
    background: #23455d;
    border: none;
    padding: 5px 8px;
}

/* -------------------------------------------------------------------------
   Scrollbars
   ------------------------------------------------------------------------- */
QScrollBar:vertical {
    width: 9px;
    margin: 2px 1px;
    background: transparent;
    border: none;
}

QScrollBar:horizontal {
    height: 9px;
    margin: 1px 2px;
    background: transparent;
    border: none;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    min-height: 24px;
    min-width: 24px;
    background: #9db6c8;
    border: none;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #789bb4;
}

QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background: #758d9f;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* -------------------------------------------------------------------------
   Visualization toolbar
   ------------------------------------------------------------------------- */
QFrame#visualizationViewToolbar {
    background: #f5f9fc;
    border-bottom: 1px solid #bcd1df;
}

QFrame#visualizationViewToolbar QToolButton {
    min-width: 27px;
    min-height: 25px;
    padding: 2px;
    color: #173247;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
}

QFrame#visualizationViewToolbar QToolButton:hover {
    background: #e1edf6;
    border-color: #b5cbd9;
}

QFrame#visualizationViewToolbar QToolButton:pressed,
QFrame#visualizationViewToolbar QToolButton:checked {
    background: #b5cedf;
    border-color: #95b2c6;
}

QFrame#visualizationToolbarSeparator {
    color: #bed0dc;
}

QMenu#visualizationOpacityMenu {
    background: #ffffff;
    border: 1px solid #a8c1d3;
    padding: 6px;
}

QLabel#visualizationOpacityPercentLabel {
    color: #173247;
    font-weight: 600;
}

QSlider#visualizationOpacitySlider::groove:vertical {
    width: 4px;
    background: #d1dde6;
    border-radius: 2px;
}

QSlider#visualizationOpacitySlider::sub-page:vertical {
    background: #347aa8;
    border-radius: 2px;
}

QSlider#visualizationOpacitySlider::add-page:vertical {
    background: #d1dde6;
    border-radius: 2px;
}

QSlider#visualizationOpacitySlider::handle:vertical {
    height: 12px;
    margin: 0px -4px;
    background: #347aa8;
    border-radius: 6px;
}

QStatusBar {
    color: #173247;
    background: #e1edf6;
    border-top: 1px solid #bed0dc;
}
