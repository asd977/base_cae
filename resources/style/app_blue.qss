/*
 * POWERCHINA-GEOCAE Classic Deep Cobalt-Sky Engineering Blue Theme
 *
 * Inspired by classic luminous cobalt-blue engineering platforms, tuned slightly deeper:
 * - Hue: clean cobalt/cerulean blue (H ≈ 211°), higher clarity and saturation (no muddy grey)
 * - Outer chrome & dock frame:   #86b0dd / #9abfe6
 * - Dock headers & status bar:   glossy #cce1f6 -> #a3c6ea, bold #123e73 text
 * - Workspace panels:            #d6e7f8 -> #c7ddf3
 * - GroupBox cards:              #f5faff -> #e7f2fc, crisp #7ba4d1 border
 * - Tree, log & data tables:     #f8fbff / #ffffff for high contrast readability
 * - Primary cobalt buttons:      glossy #2b7cd4 -> #1657a3
 */

QWidget {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "微软雅黑", "Segoe UI", sans-serif;
    font-size: 10pt;
    color: #103259;
    background-color: #dfecfa;
}

QMainWindow,
QDialog {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #a7c7e8, stop:1 #88b1dc);
}

/* Transparent text/container widgets so they blend seamlessly into cards and panels. */
QLabel,
QFrame,
QToolBar,
QToolButton,
QCheckBox,
QRadioButton {
    background: transparent;
}

QGroupBox QWidget {
    background: transparent;
}

QLabel {
    color: #103259;
}

QLabel#pageHeaderLabel {
    min-height: 0px;
    max-height: 0px;
    margin: 0px;
    padding: 0px;
    border: none;
    color: transparent;
    background: transparent;
}

QLabel#pageNameLabel {
    color: #0e3461;
    font-size: 10.5pt;
    font-weight: 600;
    padding: 0px;
    background: transparent;
}

QLabel[secondary="true"],
QLabel#boxSelectHintLabel {
    color: #3b638f;
    background: transparent;
}

/* Luminous cobalt-sky workspace panels */
DashboardPage,
DashboardPage#dashboardPage,
QScrollArea,
QScrollArea > QWidget,
QScrollArea#dashboardScrollArea,
QScrollArea#dashboardScrollArea > QWidget,
QScrollArea#dashboardScrollArea QWidget#qt_scrollarea_viewport,
QWidget#dashboardScrollContainer,
QWidget#materialEntryContent,
MaterialEntryWidget,
MaterialModelWidget,
MaterialModelWidget#materialModelPage,
MaterialTransitionPage,
MaterialTransitionPage#materialTransitionPage,
CaveBlockPlanePage,
CaveBlockStabilityWidget,
QStackedWidget#projectSettingStackWidget,
QStackedWidget#projectSettingStackWidget > QWidget,
MeshQualityCheckWidget#meshQualityCheckPage,
QScrollArea#meshQualityCheckScrollArea,
QWidget#meshQualityCheckViewport,
QWidget#meshQualityCheckContent {
    background-color: #dfecfa;
}

QWidget[dimDisabled="true"] {
    color: #7796b8;
    background-color: #d4e4f5;
}

/* -------------------------------------------------------------------------
   GroupBox Cards (clean internal title with cobalt accent bar)
   ------------------------------------------------------------------------- */
QGroupBox {
    margin-top: 2px;
    padding: 30px 10px 10px 10px;
    color: #123e73;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f2f7fd, stop:1 #e7f1fc);
    border: 1px solid #86add6;
    border-radius: 4px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: border;
    subcontrol-position: top left;
    left: 10px;
    top: 8px;
    padding: 0px 0px 0px 7px;
    color: #123e73;
    background: transparent;
    border-left: 3px solid #1e6bc0;
}

QGroupBox::indicator {
    width: 14px;
    height: 14px;
    margin-right: 4px;
}

/* -------------------------------------------------------------------------
   Buttons (crisp glossy cobalt-ice bevels)
   ------------------------------------------------------------------------- */
QPushButton {
    min-height: 27px;
    padding: 0px 10px;
    color: #103766;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fafdff, stop:0.48 #e5f1fc, stop:1 #c8dff6);
    border: 1px solid #6b96c7;
    border-radius: 3px;
}

QPushButton:hover {
    color: #0b3a70;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:0.48 #d4e8fb, stop:1 #b0d1f3);
    border-color: #2b75c7;
}

QPushButton:pressed {
    color: #092c57;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #a9ccf0, stop:1 #c4def7);
    border-color: #1a5da8;
}

QPushButton:disabled {
    color: #7c98b5;
    background: #dce9f5;
    border-color: #9cb9d6;
}

QPushButton:default,
QPushButton[primary="true"] {
    color: #ffffff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3285de, stop:0.5 #1f6bc0, stop:1 #16559e);
    border: 1px solid #124785;
    font-weight: 600;
}

QPushButton:default:hover,
QPushButton[primary="true"]:hover {
    color: #ffffff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4393e8, stop:0.5 #2878d1, stop:1 #1b61b2);
    border-color: #16559e;
}

QPushButton:default:pressed,
QPushButton[primary="true"]:pressed {
    color: #ffffff;
    background: #144d8f;
    border-color: #0e3b70;
}

QPushButton:default:disabled,
QPushButton[primary="true"]:disabled {
    color: #cce0f5;
    background: #75a3d4;
    border-color: #6292c4;
}

BarElementPlacementWidget QPushButton[inlineAction="true"] {
    min-height: 24px;
    padding: 0px 8px;
    color: #1962b3;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
}

BarElementPlacementWidget QPushButton[inlineAction="true"]:hover {
    color: #0f4787;
    background: #c5def7;
    border-color: #6b96c7;
}

QPushButton#sectionTitleButton {
    min-height: 29px;
    max-height: 29px;
    padding: 0px 2px;
    text-align: left;
    color: #123e73;
    background: transparent;
    border: none;
    border-bottom: 1px solid #82abd6;
    border-radius: 0px;
    font-weight: 600;
}

QPushButton#sectionTitleButton:hover {
    color: #1e6bc0;
    background: transparent;
    border-bottom-color: #1e6bc0;
}

/* -------------------------------------------------------------------------
   Editors & ComboBoxes
   ------------------------------------------------------------------------- */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit,
QTimeEdit,
QDateEdit {
    min-height: 26px;
    padding-left: 7px;
    padding-right: 7px;
    color: #103259;
    background: #ffffff;
    border: 1px solid #7aa3cf;
    border-radius: 3px;
    selection-background-color: #a4ccf2;
    selection-color: #0a284a;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateTimeEdit:hover,
QTimeEdit:hover,
QDateEdit:hover {
    border-color: #367dc9;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus,
QTimeEdit:focus,
QDateEdit:focus {
    border-color: #1a64b8;
    background: #ffffff;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: #7c98b5;
    background: #e5eff9;
    border-color: #9ebad6;
}

QComboBox {
    min-height: 26px;
    padding-left: 7px;
    padding-right: 24px;
    color: #103259;
    background: #ffffff;
    border: 1px solid #7aa3cf;
    border-radius: 3px;
}

QComboBox:hover {
    border-color: #367dc9;
}

QComboBox:focus {
    border-color: #1a64b8;
}

QComboBox:disabled {
    color: #7c98b5;
    background: #e5eff9;
    border-color: #9ebad6;
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    background: transparent;
    border: none;
}

QComboBox::down-arrow {
    image: url(:/resources/style/chevron_down.svg);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    color: #103259;
    background: #ffffff;
    border: 1px solid #5e8fc4;
    outline: none;
    padding: 2px;
    selection-background-color: #bad8f6;
    selection-color: #0a284a;
}

QComboBox QAbstractItemView::item:selected {
    color: #0a284a;
    background: #bad8f6;
}

QComboBox QAbstractItemView::item {
    min-height: 1.4em;
    padding: 3px 8px;
}

QPushButton[primaryAction="true"] {
    color: #ffffff;
    background: #246bb5;
    border-color: #1d5fa5;
}
QPushButton[primaryAction="true"]:hover { background: #1c5e9f; }
QPushButton[primaryAction="true"]:disabled {
    color: #849bb3;
    background: #e1ebf5;
    border-color: #b7cbdc;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 17px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f0f7fe, stop:1 #cfe3f7);
    border-left: 1px solid #8eb3db;
    border-bottom: 1px solid #8eb3db;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 17px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f0f7fe, stop:1 #cfe3f7);
    border-left: 1px solid #8eb3db;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background: #bad8f6;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(:/resources/arrow_up_drawn.svg);
    width: 8px;
    height: 8px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(:/resources/arrow_down_drawn.svg);
    width: 8px;
    height: 8px;
}

QCheckBox,
QRadioButton {
    spacing: 6px;
    color: #103259;
    background: transparent;
}

/* -------------------------------------------------------------------------
   Project Tree, Lists and Tables (harmonized soft cobalt-ice panes)
   ------------------------------------------------------------------------- */
ProjectTreeWidget,
ProjectTreeWidget QTreeWidget#projectTreeWidget,
ProjectTreeWidget QTreeWidget#projectTreeWidget QWidget#qt_scrollarea_viewport {
    background: #ebf3fc;
}

QTreeWidget#projectTreeWidget,
ProjectTreeWidget QTreeWidget#projectTreeWidget {
    color: #103259;
    background: #ebf3fc;
    border: none;
    outline: none;
    show-decoration-selected: 1;
}

QTreeWidget#projectTreeWidget::item,
ProjectTreeWidget QTreeWidget#projectTreeWidget::item {
    min-height: 28px;
    padding-left: 6px;
    padding-right: 6px;
    color: #103259;
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    font-weight: 400;
}

QTreeWidget#projectTreeWidget::item:hover,
ProjectTreeWidget QTreeWidget#projectTreeWidget::item:hover {
    color: #0e4687;
    background: #dbeafa;
    border-left-color: #6298d1;
}

QTreeWidget#projectTreeWidget::item:disabled,
ProjectTreeWidget QTreeWidget#projectTreeWidget::item:disabled {
    color: #7c98b5;
    background: #eef5fc;
}

QTreeWidget#projectTreeWidget::item:selected,
ProjectTreeWidget QTreeWidget#projectTreeWidget::item:selected {
    color: #0b376b;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #b5d5f5, stop:1 #dbeafa);
    border-left: 3px solid #1e6bc0;
    font-weight: 600;
}

QTreeWidget#projectTreeWidget::item:selected:hover,
ProjectTreeWidget QTreeWidget#projectTreeWidget::item:selected:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #a4cbf2, stop:1 #cee3f9);
}

QListWidget,
QTreeView,
QListView,
QTableView,
QTableWidget {
    color: #103259;
    background: #ffffff;
    border: 1px solid #7ca5d1;
    border-radius: 3px;
    alternate-background-color: #eef5fc;
    gridline-color: #c5dcf2;
    outline: none;
    selection-background-color: #bad8f6;
    selection-color: #0a284a;
}

QListWidget::item,
QListView::item {
    min-height: 24px;
    padding: 3px 6px;
}

QListWidget#appliedMatypesList::item {
    min-height: 24px;
    padding: 2px 5px;
}

QListWidget::item:hover,
QListView::item:hover {
    background: #dcebfa;
}

QListWidget::item:selected,
QListView::item:selected {
    color: #0a284a;
    background: #bad8f6;
}

QHeaderView::section {
    min-height: 27px;
    padding: 0px 7px;
    color: #123e73;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #eaf3fc, stop:0.5 #d2e4f7, stop:1 #bad5f2);
    border: none;
    border-right: 1px solid #8eb3db;
    border-bottom: 1px solid #6b96c7;
    font-weight: 600;
}

/* -------------------------------------------------------------------------
   Tabs
   ------------------------------------------------------------------------- */
QTabWidget::pane {
    background: #f6faff;
    border: 1px solid #7ca5d1;
    border-radius: 3px;
}

QTabBar::tab {
    min-height: 28px;
    padding: 0px 13px;
    margin: 0px;
    color: #15457a;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #dcebfb, stop:1 #b8d4f2);
    border: none;
    border-right: 1px solid #85add8;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
}

QTabBar::tab:hover:!selected {
    color: #0e4687;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e8f3fd, stop:1 #c7dff7);
}

QTabBar::tab:selected {
    color: #103f78;
    background: #f6faff;
    border-bottom: 2px solid #1e6bc0;
    font-weight: 600;
}

/* -------------------------------------------------------------------------
   Menus and Tooltips
   ------------------------------------------------------------------------- */
QMenu {
    color: #103259;
    background: #ffffff;
    border: 1px solid #6392c7;
    padding: 5px;
}

QMenu::item {
    min-height: 22px;
    padding: 5px 30px 5px 25px;
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 3px;
}

QMenu::item:selected {
    color: #0b376b;
    background: #d2e6fa;
    border-left-color: #1e6bc0;
}

QMenu::item:disabled {
    color: #7c98b5;
}

QMenu::separator {
    height: 1px;
    margin: 5px 8px;
    background: #bdd6ef;
}

QToolTip {
    color: #ffffff;
    background: #144275;
    border: 1px solid #3078c7;
    padding: 5px 8px;
}

/* -------------------------------------------------------------------------
   Scrollbars
   ------------------------------------------------------------------------- */
QScrollBar:vertical {
    width: 9px;
    margin: 2px 1px;
    background: transparent;
    border: none;
}

QScrollBar:horizontal {
    height: 9px;
    margin: 1px 2px;
    background: transparent;
    border: none;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    min-height: 24px;
    min-width: 24px;
    background: #84aed9;
    border: none;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #528bc7;
}

QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background: #1e6bc0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* -------------------------------------------------------------------------
   Visualization Toolbar & Status Bar (glossy cobalt-sky)
   ------------------------------------------------------------------------- */
QFrame#visualizationViewToolbar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #eaf3fc, stop:1 #cbe0f5);
    border-bottom: 1px solid #7ca5d1;
}

QFrame#visualizationViewToolbar QToolButton {
    min-width: 27px;
    min-height: 25px;
    padding: 2px;
    color: #103259;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
}

QFrame#visualizationViewToolbar QToolButton:hover {
    background: #bad8f6;
    border-color: #6b96c7;
}

QFrame#visualizationViewToolbar QToolButton:pressed,
QFrame#visualizationViewToolbar QToolButton:checked {
    background: #9ec6ef;
    border-color: #1e6bc0;
}

QFrame#visualizationToolbarSeparator {
    color: #8eb3db;
}

QMenu#visualizationOpacityMenu {
    background: #ffffff;
    border: 1px solid #6392c7;
    padding: 6px;
}

QLabel#visualizationOpacityPercentLabel {
    color: #103259;
    font-weight: 600;
    background: transparent;
}

QSlider#visualizationOpacitySlider::groove:vertical {
    width: 4px;
    background: #bdd6ef;
    border-radius: 2px;
}

QSlider#visualizationOpacitySlider::sub-page:vertical {
    background: #1e6bc0;
    border-radius: 2px;
}

QSlider#visualizationOpacitySlider::add-page:vertical {
    background: #bdd6ef;
    border-radius: 2px;
}

QSlider#visualizationOpacitySlider::handle:vertical {
    height: 12px;
    margin: 0px -4px;
    background: #1e6bc0;
    border-radius: 6px;
}

QStatusBar {
    color: #103766;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #cde1f6, stop:1 #a1c5ea);
    border-top: 1px solid #6b96c7;
}

/* -------------------------------------------------------------------------
   Output Log Pane (matches Model Tree & Card elevation)
   ------------------------------------------------------------------------- */
QWidget#OutputWidget,
QWidget#OutputWidget QTextEdit#textEdit,
QWidget#OutputWidget QTextEdit#textEdit QWidget#qt_scrollarea_viewport {
    background: #ebf3fc;
}

QWidget#OutputWidget QTextEdit#textEdit {
    color: #103259;
    border: none;
    padding: 8px;
    selection-background-color: #a4ccf2;
    selection-color: #0a284a;
}

QWidget#OutputWidget QPushButton#floatingClearBtn {
    min-height: 22px;
    max-height: 22px;
    min-width: 44px;
    max-width: 44px;
    padding: 0px;
    color: #12437a;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fafdff, stop:1 #cbe0f5);
    border: 1px solid #6b96c7;
    border-radius: 3px;
}

QWidget#OutputWidget QPushButton#floatingClearBtn:hover {
    color: #0b376b;
    background: #bad8f6;
    border-color: #2b75c7;
}

QWidget#OutputWidget QPushButton#floatingClearBtn:pressed {
    background: #a4ccf2;
    border-color: #1a5da8;
}

/* -------------------------------------------------------------------------
   Project Setup Dialog
   ------------------------------------------------------------------------- */
ProjectSetupDialog,
ProjectSetupDialog QWidget {
    background: #d2e4f7;
}

ProjectSetupDialog QLabel {
    color: #103259;
    background: transparent;
}

ProjectSetupDialog QLineEdit {
    color: #103259;
    background: #ffffff;
    border: 1px solid #6b96c7;
    selection-background-color: #a4ccf2;
    selection-color: #0a284a;
    placeholder-text-color: #5b81ab;
}

ProjectSetupDialog QLineEdit:focus {
    background: #ffffff;
    border-color: #1a64b8;
}

ProjectSetupDialog QPushButton {
    color: #103766;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fafdff, stop:1 #cbe0f5);
    border: 1px solid #6b96c7;
}

ProjectSetupDialog QPushButton:hover {
    color: #0b376b;
    background: #bad8f6;
    border-color: #2b75c7;
}

ProjectSetupDialog QPushButton:pressed {
    background: #a4ccf2;
    border-color: #1a5da8;
}
