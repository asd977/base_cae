/*
 * POWERCHINA-GEOCAE balanced light theme
 *
 * Direction:
 * - keep the existing engineering workflow and native desktop character;
 * - use neutral surfaces with one restrained blue-grey accent;
 * - avoid card-like styling on every container;
 * - reserve emphasis for selection, focus and primary actions.
 */

QWidget {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "微软雅黑", "Segoe UI", sans-serif;
    font-size: 9pt;
    color: #000000;
}

QMainWindow,
QDialog {
    background: #f0f2f4;
}

QLabel {
    color: #000000;
    background: transparent;
}

/* The dock title already identifies the current settings area. */
QLabel#pageHeaderLabel {
    min-height: 0px;
    max-height: 0px;
    margin: 0px;
    padding: 0px;
    border: none;
    color: transparent;
    background: transparent;
}

QLabel#pageNameLabel {
    color: #000000;
    font-size: 9.5pt;
    font-weight: 600;
    padding: 0px;
}

QLabel[secondary="true"],
QLabel#boxSelectHintLabel {
    color: #68727c;
}

/* Root/project and module dashboard pages use the same global surfaces as other settings pages. */
DashboardPage#dashboardPage,
QScrollArea#dashboardScrollArea,
QScrollArea#dashboardScrollArea > QWidget,
QWidget#dashboardScrollContainer,
QWidget#materialEntryContent,
MaterialModelWidget#materialModelPage,
MaterialTransitionPage#materialTransitionPage {
    background: #ffffff;
}

QScrollArea#dashboardScrollArea QWidget#qt_scrollarea_viewport {
    background: #ffffff;
}


/* Mesh quality page uses the current theme's editable/content surface.
   The C++ page does not hard-code any color; QPalette::Base changes with the theme. */
MeshQualityCheckWidget#meshQualityCheckPage,
QScrollArea#meshQualityCheckScrollArea,
QWidget#meshQualityCheckViewport,
QWidget#meshQualityCheckContent {
    background-color: palette(base);
}

/* -------------------------------------------------------------------------
   Buttons
   ------------------------------------------------------------------------- */
QPushButton {
    min-height: 26px;
    padding: 0px 10px;
    color: #000000;
    background: #ffffff;
    border: 1px solid #c9cfd5;
    border-radius: 2px;
}

QPushButton:hover {
    color: #294f66;
    background: #f5f7f8;
    border-color: #9eacb6;
}

QPushButton:pressed {
    background: #e8ecef;
    border-color: #7f909c;
}

QPushButton:disabled {
    color: #9ca4ab;
    background: #f3f4f5;
    border-color: #dfe3e6;
}

QPushButton:default,
QPushButton[primary="true"] {
    color: #ffffff;
    background: #3d6d88;
    border-color: #3d6d88;
    font-weight: 500;
}

QPushButton:default:hover,
QPushButton[primary="true"]:hover {
    background: #345f78;
    border-color: #345f78;
}

QPushButton:default:pressed,
QPushButton[primary="true"]:pressed {
    background: #2d5369;
    border-color: #2d5369;
}

BarElementPlacementWidget QPushButton[inlineAction="true"] {
    min-height: 24px;
    padding: 0px 8px;
    color: #2f6f9f;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
}

BarElementPlacementWidget QPushButton[inlineAction="true"]:hover {
    color: #285f89;
    background: #eef2f4;
    border-color: #d7dcdf;
}

/* Collapsible section controls remain structural, not decorative bands. */
QPushButton#sectionTitleButton {
    min-height: 29px;
    max-height: 29px;
    padding: 0px 2px;
    text-align: left;
    color: #000000;
    background: transparent;
    border: none;
    border-bottom: 1px solid #e0e4e7;
    border-radius: 0px;
    font-weight: 600;
}

QPushButton#sectionTitleButton:hover {
    color: #315a70;
    background: transparent;
    border-bottom-color: #c9d1d7;
}

/* -------------------------------------------------------------------------
   Editors
   ------------------------------------------------------------------------- */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit,
QTimeEdit,
QDateEdit {
    min-height: 26px;
    padding-left: 6px;
    padding-right: 6px;
    color: #000000;
    background: #ffffff;
    border: 1px solid #c9cfd5;
    border-radius: 2px;
    selection-background-color: #dce6ec;
    selection-color: #22343f;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateTimeEdit:hover,
QTimeEdit:hover,
QDateEdit:hover {
    border-color: #a5b0b8;
}

/* 数值编辑框右侧已由上下箭头按钮区占位，不再额外保留内边距。 */
QSpinBox,
QDoubleSpinBox {
    padding-right: 0px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus,
QTimeEdit:focus,
QDateEdit:focus {
    border-color: #7f909c;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: #949ca3;
    background: #f3f4f5;
    border-color: #dfe3e6;
}

QComboBox {
    min-height: 26px;
    padding-left: 6px;
    padding-right: 3px;
    color: #000000;
    background: #ffffff;
    border: 1px solid #c9cfd5;
    border-radius: 2px;
}

QComboBox:hover {
    border-color: #a5b0b8;
}

QComboBox:focus {
    border-color: #7f909c;
}

QComboBox:disabled {
    color: #949ca3;
    background: #f3f4f5;
    border-color: #dfe3e6;
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    background: transparent;
    border: none;
}

QComboBox::down-arrow {
    image: url(:/resources/arrow_down_drawn.svg);
    width: 8px;
    height: 8px;
}

QComboBox QAbstractItemView {
    color: #000000;
    background: #ffffff;
    border: 1px solid #c9cfd5;
    outline: none;
    padding: 2px;
    selection-background-color: #e5ecef;
    selection-color: #263c49;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 17px;
    background: #f6f7f8;
    border-left: 1px solid #d5dade;
    border-bottom: 1px solid #d5dade;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 17px;
    background: #f6f7f8;
    border-left: 1px solid #d5dade;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(:/resources/arrow_up_drawn.svg);
    width: 8px;
    height: 8px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(:/resources/arrow_down_drawn.svg);
    width: 8px;
    height: 8px;
}

QCheckBox,
QRadioButton {
    spacing: 5px;
    color: #000000;
}

/* Checkbox indicators are drawn globally by NeutralCheckStyle.
   Keep only text spacing here so QCheckBox and item-view checks stay consistent. */

/* -------------------------------------------------------------------------
   Sections and content surfaces
   ------------------------------------------------------------------------- */
QGroupBox {
    /* margin-top reserves space for the title; content padding remains compact. */
    margin-top: 12px;
    padding: 7px 6px 6px 6px;
    color: #000000;
    background: #ffffff;
    border: 1px solid #dfe3e6;
    border-radius: 2px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 6px;
    top: 0px;
    padding: 0px 3px;
    color: #000000;
    background: #ffffff;
}

QGroupBox::indicator {
    width: 14px;
    height: 14px;
    margin-right: 3px;
}

/* 窄侧栏使用不透明内容底色，避免蓝色停靠区域从容器间隙透出。 */
QWidget[visualControlPanel="true"],
QWidget#GridEditingWidget,
QWidget#widgetDisplayControl,
QWidget#PostDisplayControlWidget {
    background: #ffffff;
}

QWidget[visualControlPanel="true"] QGroupBox {
    margin-top: 11px;
    padding: 6px 5px 5px 5px;
}

QWidget[visualControlPanel="true"] QTreeWidget {
    background: #ffffff;
}

QStackedWidget#projectSettingStackWidget,
QStackedWidget#projectSettingStackWidget > QWidget,
MaterialEntryWidget,
MaterialTransitionPage,
MaterialModelWidget,
CaveBlockPlanePage,
CaveBlockStabilityWidget,
DashboardPage,
QScrollArea,
QScrollArea > QWidget {
    background: #ffffff;
}

QWidget[dimDisabled="true"] {
    color: #969ea5;
    background: #f3f4f5;
}

/* -------------------------------------------------------------------------
   Tree, lists and tables
   ------------------------------------------------------------------------- */
QTreeWidget#projectTreeWidget {
    color: #000000;
    background: #ffffff;
    border: none;
    outline: none;
    show-decoration-selected: 1;
}

QTreeWidget#projectTreeWidget::item {
    height: 26px;
    padding-left: 4px;
    padding-right: 5px;
    color: #000000;
    background: transparent;
    border: none;
    font-weight: 400;
}

QTreeWidget#projectTreeWidget::item:hover {
    color: #294f66;
    background: #f2f5f7;
}

QTreeWidget#projectTreeWidget::item:disabled {
    color: #8a95a5;
    background: #f7f8f9;
}

QTreeWidget#projectTreeWidget::item:selected {
    color: #253b47;
    background: #e6ecef;
}

QTreeWidget#projectTreeWidget::item:selected:hover {
    background: #dde6ea;
}

QListWidget,
QTreeView,
QListView,
QTableView,
QTableWidget {
    color: #000000;
    background: #ffffff;
    border: 1px solid #dfe3e6;
    alternate-background-color: #f8f9fa;
    gridline-color: #e4e7e9;
    outline: none;
    selection-background-color: #e6ecef;
    selection-color: #253b47;
}

QListWidget::item,
QListView::item {
    min-height: 24px;
    padding: 3px 6px;
}

QListWidget#appliedMatypesList::item {
    min-height: 24px;
    padding: 2px 5px;
}

QListWidget::item:hover,
QListView::item:hover {
    background: #f2f5f7;
}

QListWidget::item:selected,
QListView::item:selected {
    color: #253b47;
    background: #e6ecef;
}

QHeaderView::section {
    min-height: 27px;
    padding: 0px 7px;
    color: #000000;
    background: #f5f6f7;
    border: none;
    border-right: 1px solid #e1e4e6;
    border-bottom: 1px solid #d8dde0;
    font-weight: 500;
}

/* -------------------------------------------------------------------------
   Standard tabs: flat desktop tabs, not rounded chips
   ------------------------------------------------------------------------- */
QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #dfe3e6;
}

QTabBar::tab {
    min-height: 28px;
    padding: 0px 13px;
    margin: 0px;
    color: #000000;
    background: #f5f6f7;
    border: none;
    border-right: 1px solid #e0e4e7;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
}

QTabBar::tab:hover:!selected {
    color: #344a57;
    background: #eef2f4;
}

QTabBar::tab:selected {
    color: #2c5368;
    background: #ffffff;
    border-bottom: 2px solid #4f778d;
    font-weight: 600;
}

/* -------------------------------------------------------------------------
   Menus and tooltips
   ------------------------------------------------------------------------- */
QMenu {
    color: #000000;
    background: #ffffff;
    border: 1px solid #c9cfd5;
    padding: 5px;
}

QMenu::item {
    min-height: 20px;
    padding: 5px 30px 5px 25px;
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 3px;
}

QMenu::item:selected {
    color: #253b47;
    background: #e6ecef;
    border-left-color: #2f6f9f;
}

QMenu::item:disabled {
    color: #9ca4ab;
}

QMenu::separator {
    height: 1px;
    margin: 5px 8px;
    background: #e1e4e7;
}

QToolTip {
    color: #ffffff;
    background: #343b42;
    border: none;
    padding: 5px 8px;
}

/* -------------------------------------------------------------------------
   Scrollbars
   ------------------------------------------------------------------------- */
QScrollBar:vertical {
    width: 9px;
    margin: 2px 1px;
    background: transparent;
    border: none;
}

QScrollBar:horizontal {
    height: 9px;
    margin: 1px 2px;
    background: transparent;
    border: none;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    min-height: 24px;
    min-width: 24px;
    background: #c6ccd1;
    border: none;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #aab2b8;
}

QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background: #8f999f;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* -------------------------------------------------------------------------
   Visualization toolbar
   ------------------------------------------------------------------------- */
QFrame#visualizationViewToolbar {
    background: #fafbfc;
    border-bottom: 1px solid #e0e4e7;
}

QFrame#visualizationViewToolbar QToolButton {
    min-width: 27px;
    min-height: 25px;
    padding: 2px;
    color: #000000;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
}

QFrame#visualizationViewToolbar QToolButton:hover {
    background: #eef2f4;
    border-color: #d8dfe3;
}

QFrame#visualizationViewToolbar QToolButton:pressed,
QFrame#visualizationViewToolbar QToolButton:checked {
    background: #e0e8ec;
    border-color: #c1ced5;
}

QFrame#visualizationToolbarSeparator {
    color: #dfe3e6;
}

QMenu#visualizationOpacityMenu {
    background: #ffffff;
    border: 1px solid #c9cfd5;
    padding: 6px;
}

QLabel#visualizationOpacityPercentLabel {
    color: #000000;
    font-weight: 600;
}

QSlider#visualizationOpacitySlider::groove:vertical {
    width: 4px;
    background: #dce1e4;
    border-radius: 2px;
}

QSlider#visualizationOpacitySlider::sub-page:vertical {
    background: #4f778d;
    border-radius: 2px;
}

QSlider#visualizationOpacitySlider::add-page:vertical {
    background: #dce1e4;
    border-radius: 2px;
}

QSlider#visualizationOpacitySlider::handle:vertical {
    height: 12px;
    margin: 0px -4px;
    background: #4f778d;
    border-radius: 6px;
}

QStatusBar {
    color: #000000;
    background: #f6f7f8;
    border-top: 1px solid #dfe3e6;
}
