/* 应用基础样式 */
QWidget {
    background-color: #f7f7f7;
    color: #333333;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 10pt;
}

/* 标签栏（Ribbon） */
QTabBar::tab {
    font-size: 16px;
    padding: 0px;
    min-width: 70px;
    min-height: 30px;
    margin: 0px;
}

QTabBar::tab:!selected {
    background-color: #eaecee;
}

QTabBar::tab:selected {
    background-color: #ffffff;
}

QTabBar::tab:hover {
    background-color: #cde8ff;
}

/* 工具按钮（Ribbon 按钮） */
QToolButton {
    border: none;
    padding: 5px;
}

QToolButton:hover {
    background-color: #d3d3d3;
}

/* 普通按钮 */
QPushButton {
    border: 1px solid #d0d0d0;
    background-color: #ffffff;
    padding: 4px 8px;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #f0f0f0;
}

QPushButton:pressed {
    background-color: #e0e0e0;
}

QPushButton:disabled {
    color: #a0a0a0;
    background-color: #f5f5f5;
}

/* 菜单 */
QMenu {
    background-color: #f7f7f7;
    border: 1px solid #c6c6c6;
}

QMenu::item {
    padding: 6px 18px;
}

QMenu::item:selected {
    background-color: #e0f0ff;
}

/* 树控件 */
QTreeWidget {
    border: none;
    background-color: #ffffff;
}

QTreeWidget::item {
    height: 28px;
}

QTreeWidget::item:selected {
    background-color: #c0e2fc;
    color: #000000;
}

/* 表格 */
QTableWidget {
    gridline-color: #e5e7eb;
    alternate-background-color: #fafafa;
}

QTableWidget::item {
    padding: 6px;
    border: none;
}

QTableWidget::item:selected {
    background: #a5c9ff;
    color: #ffffff;
}

QHeaderView::section {
    background: #f3f4f6;
    padding: 6px;
    border: 0;
    border-bottom: 1px solid #e5e7eb;
    font-weight: 600;
}

/* 文本编辑 */
QTextEdit {
    border: 1px solid #d0d0d0;
    font-size: 15px;
    background-color: #ffffff;
}

QTextEdit:focus {
    border: 1px solid #999999;
}
