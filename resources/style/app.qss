/* 应用基础样式 */
QWidget {
    background-color: #f7f7f7;
    color: #333333;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 10pt;
}

/* 标签栏（Ribbon） */
QTabBar {
    background-color: #e5e5e5;
    border: none;
}

QTabBar::tab {
    font-size: 16px;
    padding: 7px 16px;
    min-width: 74px;
    min-height: 32px;
    margin: 4px 4px 0 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border: 1px solid #d0d0d0;
    border-bottom: none;
    color: #2f2f2f;
    background-color: #f6f7f9;
}

QTabBar::tab:!selected {
    color: #3b3b3b;
    background-color: #f3f3f3;
}

QTabBar::tab:selected {
    background-color: #d8e6ff;
    border-color: #7aa6e6;
    color: #1b4f9c;
}

QTabBar::tab:hover {
    background-color: #e6eefb;
    border-color: #9ab7e7;
}

/* 工具按钮（Ribbon 按钮） */
QToolButton {
    border: none;
    padding: 5px;
}

QToolButton:hover {
    background-color: #d3d3d3;
}

/* 普通按钮 */
QPushButton {
    border: 1px solid #d0d0d0;
    background-color: #ffffff;
    padding: 4px 8px;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #f0f0f0;
}

QPushButton:pressed {
    background-color: #e0e0e0;
}

QPushButton:disabled {
    color: #a0a0a0;
    background-color: #f5f5f5;
}

/* 菜单 */
QMenu {
    background-color: #f7f7f7;
    border: 1px solid #c6c6c6;
}

QMenu::item {
    padding: 6px 18px;
}

QMenu::item:selected {
    background-color: #e0f0ff;
}

/* 树控件 */
QTreeWidget {
    border: none;
    background-color: #ffffff;
}

QTreeWidget::item {
    height: 28px;
}

QTreeWidget::item:selected {
    background-color: #c0e2fc;
    color: #000000;
}

/* 表格 */
QTableWidget {
    gridline-color: #e5e7eb;
    alternate-background-color: #fafafa;
}

QTableWidget::item {
    padding: 6px;
    border: none;
}

QTableWidget::item:selected {
    background: #a5c9ff;
    color: #ffffff;
}

QHeaderView::section {
    background: #f3f4f6;
    padding: 6px;
    border: 0;
    border-bottom: 1px solid #e5e7eb;
    font-weight: 600;
}

/* 文本编辑 */
QTextEdit {
    border: 1px solid #d0d0d0;
    font-size: 15px;
    background-color: #ffffff;
}

QTextEdit:focus {
    border: 1px solid #999999;
}
