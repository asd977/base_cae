QWidget {
    font-family: "Microsoft YaHei", "微软雅黑", "Segoe UI", sans-serif;
    font-size: 9pt;
}

/* PushButtons: Solid industrial flat style */
QPushButton {
    min-height: 24px;
    color: #1e293b;
    background-color: #f3f4f6;
    border: 1px solid #abb5c2;
    border-radius: 2px;
    padding: 0 10px;
}

QPushButton:hover {
    background-color: #e5e7eb;
    border-color: #0078d4;
}

QPushButton:pressed {
    background-color: #d1d5db;
    border-color: #005a9e;
}

/* Dock/Panel headers: Solid grey-blue header style */
QPushButton#sectionTitleButton {
    background-color: #e5e9f0;
    border-top: none;
    border-bottom: 1px solid #cbd5e1;
    border-left: none;
    border-right: none;
    min-height: 28px;
    max-height: 28px;
    text-align: left;
    padding-left: 8px;
    color: #2c3e50;
    font-weight: bold;
    border-radius: 0px;
}

QPushButton#sectionTitleButton:hover {
    background-color: #dbe1ec;
}

QLabel {
    color: #1e293b;
}

QLabel#pageNameLabel {
    font-size: 13pt;
    font-weight: bold;
    padding-left: 6px;
    color: #3a7bc8;
}

QLabel#pageHeaderLabel {
    background-color: #e5e9f0;
    border-top: none;
    border-bottom: 1px solid #cbd5e1;
    border-left: none;
    border-right: none;
    min-height: 28px;
    max-height: 28px;
    padding-left: 8px;
    font-size: 9.5pt;
    font-weight: bold;
    color: #2c3e50;
}

/* Inputs & Spinboxes: Sharp corners, solid gray borders */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit {
    border: 1px solid #c4cdd5;
    border-radius: 2px;
    min-height: 24px;
    padding-left: 6px;
    padding-right: 6px;
    color: #1e293b;
    background-color: #ffffff;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus {
    border-color: #4a90d9;
    outline: none;
}

/* Dropdowns */
QComboBox {
    color: #1e293b;
    padding-left: 6px;
    background: #ffffff;
    border: 1px solid #c4cdd5;
    border-radius: 2px;
    min-height: 24px;
}

QComboBox:hover {
    background: #ffffff;
    border-color: #4a90d9;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    background: #f3f4f6;
    border-left: 1px solid #c4cdd5;
}

QComboBox::down-arrow {
    image: url(:/resources/arrow_down_drawn.svg);
    width: 8px;
    height: 8px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #c4cdd5;
    selection-background-color: #e8f0fe;
    selection-color: #1a3a5c;
    outline: none;
    padding: 2px;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border-left: 1px solid #c4cdd5;
    border-bottom: 1px solid #c4cdd5;
    background: #f3f4f6;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    border-left: 1px solid #c4cdd5;
    background: #f3f4f6;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(:/resources/arrow_up_drawn.svg);
    width: 8px;
    height: 8px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(:/resources/arrow_down_drawn.svg);
    width: 8px;
    height: 8px;
}

QRadioButton,
QCheckBox,
QGroupBox {
}

QTableWidget,
QTreeWidget,
QListWidget {
    gridline-color: #e2e6ea;
    alternate-background-color: #f8f9fa;
}

/* Global scrollbars: Thin, rounded, modern */
QScrollBar:vertical {
    width: 8px;
    background: transparent;
    border: none;
    margin: 2px 1px;
}

QScrollBar:horizontal {
    height: 8px;
    background: transparent;
    border: none;
    margin: 1px 2px;
}

QScrollBar::handle:vertical {
    min-height: 24px;
    background: #c1c7d0;
    border: none;
    border-radius: 3px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    min-width: 24px;
    background: #c1c7d0;
    border: none;
    border-radius: 3px;
    margin: 0px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #a5adba;
}

QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background: #7a869a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

QStackedWidget#projectSettingStackWidget {
    background-color: white;
}

/* =========================================================================
   Model Tree: Professional CAE-style tree with subtle selection indicator
   ========================================================================= */
QTreeWidget#projectTreeWidget {
    border: none;
    font-family: "Microsoft YaHei", "微软雅黑", "Segoe UI", sans-serif;
    font-size: 9pt;
    outline: none;
    color: #2c3e50;
    background-color: #ffffff;
    show-decoration-selected: 1;
}

QTreeWidget#projectTreeWidget::item {
    height: 26px;
    padding-left: 4px;
    padding-right: 4px;
    color: #2c3e50;
    background-color: transparent;
    border: none;
    border-left: 2px solid transparent;
    margin: 0px;
}

QTreeWidget#projectTreeWidget::item:hover {
    background-color: #f0f3f7;
    color: #1a3a5c;
}

QTreeWidget#projectTreeWidget::item:selected {
    background-color: #e8f0fe;
    color: #1a3a5c;
    border-left: 2px solid #4a90d9;
}

QTreeWidget#projectTreeWidget::item:selected:hover {
    background-color: #dce8fa;
    color: #1a3a5c;
    border-left: 2px solid #4a90d9;
}

QTreeWidget#projectTreeWidget::branch {
    background: transparent;
    border-image: none;
    image: none;
}

QTreeWidget#projectTreeWidget::branch:has-children:closed {
    image: url(:/resources/style/chevron_right.svg);
}

QTreeWidget#projectTreeWidget::branch:has-children:open {
    image: url(:/resources/style/chevron_down.svg);
}

QTreeWidget#projectTreeWidget::branch:selected {
    background-color: #e8f0fe;
}

QTreeWidget#projectTreeWidget::branch:hover:!selected {
    background-color: #f0f3f7;
}

/* Visualization View styling */
QFrame#visualizationViewToolbar {
    background: #f8fafc;
    border-bottom: 1px solid #e2e6ea;
}

QFrame#visualizationViewToolbar QToolButton {
    min-width: 28px;
    min-height: 24px;
    border: 1px solid transparent;
    border-radius: 2px;
    background: transparent;
    padding: 2px;
}

QFrame#visualizationViewToolbar QToolButton:hover {
    background: #e8ecf0;
    border-color: #c4cdd5;
}

QFrame#visualizationViewToolbar QToolButton:pressed {
    background: #d5dbe2;
    border-color: #4a90d9;
}

QFrame#visualizationToolbarSeparator {
    color: #e2e6ea;
}

QMenu#visualizationOpacityMenu {
    background: #ffffff;
    border: 1px solid #c4cdd5;
    border-radius: 3px;
    padding: 6px;
}

QLabel#visualizationOpacityPercentLabel {
    font: 600 9pt "Microsoft YaHei";
    color: #1e293b;
}

QSlider#visualizationOpacitySlider::groove:vertical {
    width: 4px;
    background: #e2e6ea;
    border-radius: 2px;
}

QSlider#visualizationOpacitySlider::sub-page:vertical {
    background: #4a90d9;
    border-radius: 1px;
}

QSlider#visualizationOpacitySlider::add-page:vertical {
    background: #e2e6ea;
    border-radius: 1px;
}

QSlider#visualizationOpacitySlider::handle:vertical {
    height: 12px;
    margin: 0 -4px;
    border-radius: 6px;
    background: #4a90d9;
}

QWidget[dimDisabled="true"] {
    color: #9ca3af;
    background-color: #f3f4f6;
}

MaterialEntryWidget,
MaterialTransitionPage,
MaterialModelWidget,
CaveBlockPlanePage,
CaveBlockStabilityWidget,
DashboardPage,
QScrollArea,
QScrollArea > QWidget {
    background-color: #ffffff;
}

/* QMenu (Context Menu): Clean, professional */
QMenu {
    background-color: #ffffff;
    border: 1px solid #c4cdd5;
    border-radius: 3px;
    padding: 4px 0px;
}

QMenu::item {
    padding: 5px 24px 5px 12px;
    color: #2c3e50;
    background-color: transparent;
}

QMenu::item:selected {
    background-color: #e8f0fe;
    color: #1a3a5c;
}

QMenu::separator {
    height: 1px;
    background-color: #e2e6ea;
    margin: 4px 8px;
}

QMenu::icon {
    padding-left: 8px;
}

/* QGroupBox: Clean section borders */
QGroupBox {
    border: 1px solid #e2e6ea;
    border-radius: 3px;
    margin-top: 8px;
    padding-top: 16px;
    font-weight: bold;
    color: #2c3e50;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #4a5568;
}

/* QListWidget: Clean item styling */
QListWidget {
    border: 1px solid #e2e6ea;
    border-radius: 2px;
    background-color: #ffffff;
    outline: none;
}

QListWidget::item {
    padding: 4px 6px;
    border: none;
}

QListWidget::item:hover {
    background-color: #f0f3f7;
}

QListWidget::item:selected {
    background-color: #e8f0fe;
    color: #1a3a5c;
}

/* QTabWidget styling (if any) */
QTabWidget::pane {
    border: 1px solid #e2e6ea;
    background: #ffffff;
}

QTabBar::tab {
    background: #f3f4f6;
    border: 1px solid #e2e6ea;
    border-bottom: none;
    padding: 5px 14px;
    margin-right: 1px;
    color: #4a5568;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #1a3a5c;
    border-bottom: 2px solid #4a90d9;
}

QTabBar::tab:hover:!selected {
    background: #e8ecf0;
}

/* QToolTip */
QToolTip {
    background-color: #2c3e50;
    color: #f8fafc;
    border: none;
    padding: 4px 8px;
    border-radius: 2px;
    font-size: 9pt;
}
