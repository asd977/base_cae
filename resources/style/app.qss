/* 全局基础样式 */
QWidget {
    background-color: #f3f6fb;
    color: #1f2a3d;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 10.5pt;
}

/* 标签栏（Ribbon） */
QTabWidget::pane {
    border: 0;
    padding-top: 2px;
    background: #f3f6fb;
}

QTabBar::tab {
    font-size: 15px;
    padding: 10px 18px;
    min-width: 84px;
    min-height: 34px;
    margin: 0 4px;
    border: 1px solid transparent;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    background: rgba(255, 255, 255, 0.65);
    color: #5b6b7f;
}

QTabBar::tab:!selected {
    border-color: transparent;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #1f2a3d;
    border: 1px solid #c9d8f5;
    border-bottom: 1px solid #ffffff;
}

QTabBar::tab:hover {
    background: #e8f0ff;
    border: 1px solid #c3d6ff;
    color: #1c4f9a;
}

/* Ribbon 工具按钮 */
QToolButton {
    border: 1px solid transparent;
    padding: 8px 10px;
    background-color: #fafdff;
    border-radius: 6px;
    color: #1f2a3d;
    min-height: 32px;
}

QToolButton:hover {
    border-color: #c3d6ff;
    background-color: #eaf2ff;
}

QToolButton:pressed {
    border-color: #99b8ff;
    background-color: #dce8ff;
}

/* 普通按钮 */
QPushButton {
    border: 1px solid #c3d6ff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #fafdff, stop:1 #e7f0ff);
    padding: 6px 12px;
    border-radius: 6px;
    color: #1f2a3d;
    font-weight: 600;
}

QPushButton:hover {
    border-color: #8fb0ff;
    background-color: #e2ecff;
}

QPushButton:pressed {
    background-color: #d6e2ff;
    border-color: #6f95ff;
}

QPushButton:disabled {
    color: #9ba7ba;
    background-color: #f4f6fb;
    border-color: #e2e6ef;
}

/* 输入控件 */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QDateTimeEdit {
    border: 1px solid #d6deea;
    border-radius: 5px;
    background: #ffffff;
    padding: 4px 8px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {
    border-color: #8fb0ff;
}

QComboBox::drop-down {
    width: 24px;
    border-left: 1px solid #d6deea;
}

QComboBox::down-arrow {
    image: url(:/resources/down_arrow.png);
    width: 10px;
    height: 10px;
}

/* 菜单 */
QMenu {
    background-color: #ffffff;
    border: 1px solid #d6deea;
    padding: 6px 0;
}

QMenu::item {
    padding: 8px 20px;
    color: #1f2a3d;
}

QMenu::item:selected {
    background-color: #eaf2ff;
    color: #1c4f9a;
}

/* 树控件 */
QTreeWidget {
    border: 1px solid #e2e6ef;
    background-color: #ffffff;
    border-radius: 6px;
}

QTreeWidget::item {
    height: 30px;
    padding-left: 6px;
}

QTreeWidget::item:selected {
    background-color: #dce8ff;
    color: #1c4f9a;
}

/* 表格 */
QTableWidget {
    gridline-color: #e2e6ef;
    alternate-background-color: #f7f9fd;
    border: 1px solid #e2e6ef;
    border-radius: 6px;
}

QTableWidget::item {
    padding: 8px;
    border: none;
}

QTableWidget::item:selected {
    background: #d6e2ff;
    color: #1f2a3d;
}

QHeaderView::section {
    background: #f0f3fa;
    padding: 8px 10px;
    border: 0;
    border-bottom: 1px solid #dce2ed;
    font-weight: 600;
    color: #4b5a70;
}

/* 文本编辑 */
QTextEdit {
    border: 1px solid #d6deea;
    font-size: 15px;
    background-color: #ffffff;
    border-radius: 6px;
    padding: 6px;
}

QTextEdit:focus {
    border: 1px solid #8fb0ff;
}

/* 分组框 */
QGroupBox {
    border: 1px solid #dce2ed;
    border-radius: 6px;
    margin-top: 10px;
    padding: 6px;
    background: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #4b5a70;
}

/* 滚动条 */
QScrollBar:vertical {
    background: #f0f3fa;
    width: 12px;
    margin: 4px 0;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #c3d6ff;
    min-height: 24px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #99b8ff;
}

QScrollBar:horizontal {
    background: #f0f3fa;
    height: 12px;
    margin: 0 4px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #c3d6ff;
    min-width: 24px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #99b8ff;
}

QStatusBar {
    background: #f0f3fa;
    border-top: 1px solid #dce2ed;
    padding: 4px 8px;
}
