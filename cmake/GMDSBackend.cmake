# Use the real, pinned GMDS blocking implementation in an isolated worker.
# Only its core modules are built; FAC/GTS, Python and research meshing modules
# are unnecessary because CAE provides the exact OpenCASCADE GeomManager.
include_guard(GLOBAL)
set(CAE_GMDS_SOURCE_DIR "${CAE_3RDPARTY_ROOT}/gmds-src" CACHE PATH "Pinned GMDS source")
set(CAE_GMDS_EIGEN_ROOT "${CAE_3RDPARTY_ROOT}/eigen3" CACHE PATH "Eigen headers")
set(CAE_GMDS_CGAL_ROOT "${CAE_3RDPARTY_ROOT}/cgal" CACHE PATH "CGAL headers")
if(EXISTS "${CAE_GMDS_SOURCE_DIR}/.git")
    execute_process(COMMAND git -C "${CAE_GMDS_SOURCE_DIR}" rev-parse HEAD OUTPUT_VARIABLE _gmds_revision OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _gmds_git_status)
    if(NOT _gmds_git_status EQUAL 0 OR NOT _gmds_revision STREQUAL "6c8090df3b3dab9c087053661d83b12831d766b3")
        message(FATAL_ERROR "GMDS revision mismatch; use scripts/SetupGMDS.ps1 with a separate LibraryRoot.")
    endif()
endif()
foreach(_entry "${CAE_GMDS_SOURCE_DIR}/core/blocking/src/CurvedBlocking.cpp"
        "${CAE_GMDS_EIGEN_ROOT}/include/eigen3/Eigen/Core"
        "${CAE_GMDS_CGAL_ROOT}/include/CGAL/Generalized_map.h")
    if(NOT EXISTS "${_entry}")
        message(FATAL_ERROR "GMDS dependency missing: ${_entry}. Run scripts/SetupGMDS.ps1 first.")
    endif()
endforeach()
include(GenerateExportHeader)
function(cae_gmds_module name directory)
    file(READ "${CAE_GMDS_SOURCE_DIR}/${directory}/CMakeLists.txt" _module)
    string(REGEX MATCH "set\\(GMDS_SRC[^)]*\\)" _source_list "${_module}")
    string(REGEX MATCHALL "src/[A-Za-z0-9_]+[.]cpp" _relative "${_source_list}")
    set(_src)
    foreach(_file IN LISTS _relative)
        list(APPEND _src "${CAE_GMDS_SOURCE_DIR}/${directory}/${_file}")
    endforeach()
    add_library(${name} STATIC ${_src})
    set_target_properties(${name} PROPERTIES AUTOMOC OFF AUTOUIC OFF AUTORCC OFF)
    generate_export_header(${name} EXPORT_FILE_NAME "${CMAKE_BINARY_DIR}/exports/${name}_export.h" EXPORT_MACRO_NAME ${name}_API)
    target_include_directories(${name} PUBLIC "${CAE_GMDS_SOURCE_DIR}/${directory}/inc" "${CMAKE_BINARY_DIR}/exports")
    target_compile_definitions(${name} PUBLIC ${name}_STATIC_DEFINE NOMINMAX)
endfunction()
