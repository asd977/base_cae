      <item row="2" column="1"><widget class="QLineEdit" name="tstaEdit"><property name="text"><string>0.000000</string></property></widget></item>
      <item row="3" column="0"><widget class="QLabel" name="d4"><property name="text"><string>计算终止时刻 (s)</string></property></widget></item>
      <item row="3" column="1"><widget class="QLineEdit" name="tendEdit"><property name="text"><string>30.000000</string></property></widget></item>
      <item row="4" column="0"><widget class="QLabel" name="d5"><property name="text"><string>是否计算振动模态</string></property></widget></item>
      <item row="4" column="1"><widget class="QLineEdit" name="ifModeEdit"><property name="text"><string>1</string></property></widget></item>
      <item row="5" column="0"><widget class="QLabel" name="d6"><property name="text"><string>是否进行时程计算</string></property></widget></item>
      <item row="5" column="1"><widget class="QLineEdit" name="ifWaveEdit"><property name="text"><string>1</string></property></widget></item>
