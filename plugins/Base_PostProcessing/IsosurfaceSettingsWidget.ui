   <string notr="true">QWidget{
font-family: &quot;Microsoft YaHei&quot;, &quot;微软雅黑&quot;;
}
QPushButton#pushButton_2,
QPushButton#pushButton {
    background-color: rgb(224, 233, 244);
    border-width: 1px;
    border-color: rgb(121, 121, 121);
    border-style: solid;
    height: 33px;
    border-top: 1px solid rgb(169, 169, 169); /* 上边框为灰色 */
    border-bottom: 1px solid rgb(169, 169, 169); /* 下边框为灰色 */
    border-left: none; /* 移除左边框 */
    border-right: none;
    text-align: left;
	padding-left: 15px;
	font-size: 17px;
	border-style: solid;
}
QLabel {
    font-family: &quot;Microsoft YaHei&quot;, &quot;微软雅黑&quot;;
    font-size: 17px;
    text-align: left;
    color: rgb(51, 51, 51);
    white-space: nowrap;
    line-height: 50px;
    position: absolute;
    top: 0px;
    left: 0px;
}
QLabel#label {
    font-size: 20px;
    font-family: &quot;Microsoft YaHei&quot;, 微软雅黑;
    text-align: left;
	padding-left:9px;
    color: rgb(53, 103, 147);
}
QComboBox {
    font-family: &quot;Microsoft YaHei&quot;, 微软雅黑;
    font-size: 17px;
    text-align: left;
    color: rgb(51, 51, 51);
    padding-left:6px;
    background: rgb(240, 240, 240);
    border: 1px solid rgb(169, 169, 169);
    border-radius: 3px; /* 设置边框的圆角半径为5像素 */
}
QComboBox::drop-down {
    background: rgb(240, 240, 240);
}
QComboBox::down-arrow {
    image: url(:/resources/down_arrow.png); /* 替换下拉箭头图标 */
}
/*QCombobox右侧按钮*/
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;/*放于右方顶部*/
    border-top-right-radius: 3px;/*设置边框圆角*/
    border-bottom-right-radius: 3px;
}
QLineEdit {
    border: 1px solid rgb(200, 200, 200); /* 设置边框为淡灰色 */
    border-radius: 2px; /* 设置圆角半径为 5 像素 */
	font-size: 17px;
}
QLineEdit:focus {
    border-color: rgb(100, 100, 255); /* 设置焦点时的边框颜色为蓝色 */
    outline: none; /* 去掉默认的焦点边框 */
}

QRadioButton {
    font-size: 17px; /* 设置字体大小为 14 像素 */
}

QCheckBox {
    font-size: 17px; /* 设置字体大小为 14 像素 */
}

QGroupBox{
    font-size: 17px; /* 设置字体大小为 14 像素 */   
}

QPushButton#pushButton_contour_multi{
    background-color: rgb(255, 255, 255); /* 背景色 */
    border-width: 1px;                   /* 边框宽度 */
    border-color: rgb(121, 121, 121);    /* 边框颜色 */	
	font-size: 17px;
    border-style: solid;                 /* 边框样式 */
    border-radius: 2px;                /* 边框圆角 */
    text-align: center;                    /* 文字左对齐 */

    /* 默认状态 */
}
QPushButton#pushButton_contour_multi:hover{
    background-color: rgb(235, 235, 235); /* 悬浮时的背景色 */
    border-color: rgb(100, 100, 100);     /* 悬浮时的边框颜色 */
}

QPushButton#pushButton_contour_multi:pressed{
    background-color: rgb(200, 200, 200); /* 点击时的背景色 */
    border-color: rgb(80, 80, 80);         /* 点击时的边框颜色 */
}

QPushButton#pushButton_contour_single{
    background-color: rgb(255, 255, 255); /* 背景色 */
    border-width: 1px;                   /* 边框宽度 */
    border-color: rgb(121, 121, 121);    /* 边框颜色 */	
	font-size: 17px;
    border-style: solid;                 /* 边框样式 */
    border-radius: 2px;                /* 边框圆角 */
    text-align: center;                    /* 文字左对齐 */

    /* 默认状态 */
}
QPushButton#pushButton_contour_single:hover{
    background-color: rgb(235, 235, 235); /* 悬浮时的背景色 */
    border-color: rgb(100, 100, 100);     /* 悬浮时的边框颜色 */
}

QPushButton#pushButton_contour_single:pressed{
    background-color: rgb(200, 200, 200); /* 点击时的背景色 */
    border-color: rgb(80, 80, 80);         /* 点击时的边框颜色 */
}</string>
