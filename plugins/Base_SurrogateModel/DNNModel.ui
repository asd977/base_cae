font-family: &quot;Microsoft YaHei&quot;, &quot;微软雅黑&quot;;
}
QPushButton#pushButton_5,
QPushButton#pushButton_6,
QPushButton#pushButton_9
{
    background-color: rgb(224, 233, 244);
    border-width: 1px;
    border-color: rgb(121, 121, 121);
    border-style: solid;
    height: 33px;
    border-top: 1px solid rgb(169, 169, 169); /* 上边框为灰色 */
    border-bottom: 1px solid rgb(169, 169, 169); /* 下边框为灰色 */
    border-left: none; /* 移除左边框 */
    border-right: none;
    text-align: left;
        padding-left: 15px;
        font-size: 17px;
        border-style: solid;
}
QLabel {
    font-family: &quot;Microsoft YaHei&quot;, &quot;微软雅黑&quot;;
    font-size: 17px;
    text-align: left;
    color: rgb(51, 51, 51);
    white-space: nowrap;
    line-height: 50px;
    position: absolute;
    top: 0px;
    left: 0px;
}

QLabel#label_2 {
    font-size: 20px;
    font-family: &quot;Microsoft YaHei&quot;, 微软雅黑;
    text-align: left;
        padding-left:9px;
    color: rgb(53, 103, 147);
}



QComboBox {
    font-family: &quot;Microsoft YaHei&quot;, 微软雅黑;
    font-size: 17px;
    text-align: left;
    color: rgb(51, 51, 51);
        padding-left:6px;
    background: rgb(240, 240, 240);
    border: 1px solid rgb(169, 169, 169);
    border-radius: 3px; /* 设置边框的圆角半径为5像素 */
}
QComboBox::drop-down {
    background: rgb(240, 240, 240);
}
QComboBox::down-arrow {
    image: url(:/resources/down_arrow.png); /* 替换下拉箭头图标 */
}
/*QCombobox右侧按钮*/
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;/*放于右方顶部*/
    border-top-right-radius: 3px;/*设置边框圆角*/
    border-bottom-right-radius: 3px;
}
QLineEdit {
    border: 1px solid rgb(200, 200, 200); /* 设置边框为淡灰色 */
    border-radius: 2px; /* 设置圆角半径为 5 像素 */
        font-size: 17px;
}
QLineEdit:focus {
    border-color: rgb(100, 100, 255); /* 设置焦点时的边框颜色为蓝色 */
    outline: none; /* 去掉默认的焦点边框 */
}

QPushButton#browseSourceFilepushButton,
QPushButton#importSourceFilePushButton,
QPushButton#startTrainModel,
QPushButton#continueTrainModel,
QPushButton#addLayerButton,
QPushButton#deleteLayerButton {
    background-color: rgb(255, 255, 255); /* 背景色 */
    border-width: 1px;                   /* 边框宽度 */
    border-color: rgb(121, 121, 121);    /* 边框颜色 */
    border-style: solid;                 /* 边框样式 */
        font-size:17px;
    border-radius: 2px;                /* 边框圆角 */
    text-align: center;                    /* 文字左对齐 */

    /* 默认状态 */
}
QPushButton#browseSourceFilepushButton:hover,
QPushButton#importSourceFilePushButton:hover,
QPushButton#startTrainModel:hover,
QPushButton#continueTrainModel:hover,
QPushButton#addLayerButton:hover,
QPushButton#deleteLayerButton:hover {
    background-color: rgb(235, 235, 235); /* 悬浮时的背景色 */
    border-color: rgb(100, 100, 100);     /* 悬浮时的边框颜色 */
}

QPushButton#browseSourceFilepushButton:pressed,
QPushButton#importSourceFilePushButton:pressed,
QPushButton#startTrainModel:pressed,
QPushButton#continueTrainModel:pressed,
QPushButton#addLayerButton:pressed,
QPushButton#deleteLayerButton:pressed  {
    background-color: rgb(200, 200, 200); /* 点击时的背景色 */
    border-color: rgb(80, 80, 80);         /* 点击时的边框颜色 */
}
QRadioButton {
    font-size: 17px; /* 设置字体大小为 14 像素 */
}


QSpinBox {
    border: 1px solid rgb(169, 169, 169); /* 设置边框宽度和颜色 */
    border-radius: 3px; /* 设置边框圆角 */
    padding: 1px; /* 设置内边距 */
        padding-left:6px;
    background-color: rgb(240, 240, 240); /* 设置背景色 */
    font-size: 17px; /* 设置字体大小 */
}
QSpinBox::up-button, QSpinBox::down-button {
    border: 1px solid transparent; /* 保留一个透明边框 */
    background-color: rgb(240, 240, 240); /* 设置按钮背景色 */
}
QSpinBox::up-arrow { /* 向上箭头，图片大小为8x8 */
        image: url(:/resources/up_arrow.png);
}

QSpinBox::down-arrow{
        image: url(:/resources/down_arrow.png);
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #ddd; /* 设置按钮鼠标悬停时的背景色 */
}
