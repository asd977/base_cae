}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/resources/down_arrow.png);
    width: 10px;
    height: 10px;
}
QRadioButton, QCheckBox, QGroupBox {
    font-size: 17px;
}
QTableWidget, QTreeWidget, QListWidget {
